# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# co so du lieu SQLite cuc bo
/data
/data-*

# cau hinh cong cu dev cuc bo (giu launch.json de moi session mo giao dien duoc ngay)
/.claude/*
!/.claude/launch.json
# chuẩn vận hành dùng chung cho mọi phiên: hook bảo vệ + agent phản biện (docs/BAOR_OPERATING_MODEL.md)
!/.claude/settings.json
!/.claude/agents/

# mau bien moi truong (khong co gia tri that) duoc phep commit
!.env.example

# bằng chứng verify / báo cáo E2E ở máy (gắn commit, không commit)
/artifacts
/test-results
/playwright-report

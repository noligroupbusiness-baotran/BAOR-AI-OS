# BAOR AI OS — biến môi trường. Sao chép thành .env (VPS) hoặc .env.local (máy dev). KHÔNG commit tệp có giá trị thật.

# Bắt buộc trên production. Ký cookie phiên và mã hóa token nền tảng, khóa TOTP, mã dự phòng.
# Sinh bằng: openssl rand -hex 32   (đổi khóa: xem README "Xoay khóa")
AUTH_SECRET=

# Tài khoản quản trị lần đầu. Sau khi đổi mật khẩu trong Tài khoản của tôi, mật khẩu lưu dạng băm trong CSDL
# và ADMIN_PASSWORD không còn dùng nữa (có thể xóa khỏi tệp này).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Địa chỉ công khai (https://...) — cookie phiên chỉ an toàn qua HTTPS; đường dẫn webhook hiển thị theo biến này.
PUBLIC_URL=https://mkt.baor.vn

# Khóa Claude cho các việc cần AI (tùy chọn; thiếu thì chỉ chạy phần theo luật).
ANTHROPIC_API_KEY=

# Sao lưu CSDL lên repo riêng (tùy chọn). Token chỉ cần quyền contents:write trên repo sao lưu.
BACKUP_GITHUB_TOKEN=
BACKUP_INTERVAL_MINUTES=20

# Chỉ máy dev: mở trang là vào thẳng quản trị với email này (bản production bỏ qua hoàn toàn).
# DEV_AUTO_LOGIN_EMAIL=dev@local.test

# Docker: cổng app lắng nghe trên 127.0.0.1 (proxy Caddy/Nginx trỏ vào), và tên miền khi chạy kèm Caddy.
APP_PORT=3200
DOMAIN=mkt.baor.vn
